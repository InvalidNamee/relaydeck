[Unit]
Description=Relaydeck LAN Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/relaydeck
EnvironmentFile=/etc/relaydeck/gateway.env
ExecStart=/usr/bin/npm run gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/relaydeck

[Install]
WantedBy=multi-user.target
