# 至少 32 个字符。未设置时 npm run dev 会生成一次性令牌并打印。
GATEWAY_TOKEN=replace-with-at-least-32-random-characters
# 监听全部网卡供局域网客户端访问；请勿在路由器配置端口转发。
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8788
RELAYDECK_DATA_DIR=data

# 可选：逗号分隔的 WebSocket Origin 白名单。留空时仅依赖访问令牌。
GATEWAY_ALLOWED_ORIGINS=

# Chrome DevTools 只应监听本机。
CDP_HTTP_URL=http://127.0.0.1:9222
CDP_PORT=9222
DEFAULT_URL=about:blank

# 网关是否自动启动和关闭专用 Chrome。
AUTO_START_CHROME=1
CHROME_HEADLESS=0
